{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>vernaillen/renovate-config"],
  "packageRules": [
    {
      "description": "Security rebuilds of the pinned wordpress image: merge to main right away, Coolify redeploys",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["wordpress"],
      "matchUpdateTypes": ["digest"],
      "schedule": ["at any time"],
      "minimumReleaseAge": null,
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    {
      "description": "A MySQL version upgrade migrates the database: only on request from the Dependency Dashboard",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["mysql"],
      "matchUpdateTypes": ["major", "minor"],
      "dependencyDashboardApproval": true
    }
  ]
}
